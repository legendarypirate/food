PORT=3001
NODE_ENV=development
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=food
DB_USER=postgres
DB_PASSWORD=your_password
# Comma-separated admin URLs (optional — :3000 origins are auto-allowed)
CORS_ORIGIN=http://localhost:3000,http://165.245.189.30:3000
HOST=0.0.0.0

# Mongolia MO SMS phone verification (https://api.verify.mn)
# Required for SMS login. Never commit the real key.
VERIFY_MN_API_KEY=

# Firebase Cloud Messaging (download service account from Firebase Console)
# Option 1: path to JSON file
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Option 2: inline JSON (single line)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Wire.mn payments (https://docs.wire.mn) — QPay, bank apps, QR via one API key
# Get your key from wire.mn dashboard → Project → API keys
WIRE_API_KEY=sk_test_...
# Test mode: sandbox | Live: operator ids from your Wire dashboard (e.g. qpay)
WIRE_ALLOWED_OPERATORS=sandbox
# Optional webhook (register at Wire dashboard → Webhooks)
# WIRE_WEBHOOK_URL=https://your-server.com/api/payments/webhook
# WIRE_WEBHOOK_SECRET=whsec_...

# Cloudinary (signed uploads via POST /api/uploads — keep the secret on the server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
